    {
      "id": "background-run-guide",
      "title": "设置后台运行",
      "icon": "battery-charging",
      "priority": 75,
      "prompt": "请启动并完整执行 wuxianpi.background-run-guide；先展示适合浏览器搜索的简短问题和适合豆包、DeepSeek、ChatGPT 的详细问题，再按当前 APK 类型说明需要设置哪些应用，等待用户完成后结束。不要申请系统权限，不要自动修改系统设置。",
      "visibleWhen": "always",
      "requiresPlugins": ["wuxianpi.background-run-guide"]
    }
  ],
  "assistantContexts": [
    {
      "path": "prompts/instruction.md",
      "scope": "session",
      "provider": "static"
    }
  ],
  "documents": [
    { "path": "docs/guide.md", "title": "后台运行设置说明" }
  ]
