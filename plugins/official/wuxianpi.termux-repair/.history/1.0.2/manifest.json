{
  "schemaVersion": 1,
  "id": "wuxianpi.termux-repair",
  "version": "1.0.2",
  "name": "Termux 修复",
  "description": "诊断并显式补齐 Android-Termux 固定入口与 service-manager 常驻链路。",
  "category": "repair",
  "minHostVersion": 12,
  "requiredCapabilities": ["termux", "persistent-terminal"],
  "tags": ["Termux", "tmux", "权限"],
  "entryWorkflow": "workflows/diagnose.json",
  "actions": [
    {
      "id": "repair-control-plane-entry",
      "title": "修复运行中枢入口",
      "icon": "wrench",
      "priority": 85,
      "prompt": "请先诊断两个运行中枢固定脚本；确认缺失或不可执行并获得我的修复意图后，执行 workflows/repair-control-plane.json，最后验证 health 和带 token 的服务列表。",
      "visibleWhen": "always",
      "requiresPlugins": ["wuxianpi.termux-repair"]
    }
  ],
  "documents": [
    { "path": "docs/guide.md", "title": "Termux 故障排查" },
    { "path": "scripts/openhouse-control-plane-start", "title": "Android-Termux 固定入口" },
    { "path": "scripts/start-service-manager.sh", "title": "Termux service-manager 启动脚本" }
  ]
}
