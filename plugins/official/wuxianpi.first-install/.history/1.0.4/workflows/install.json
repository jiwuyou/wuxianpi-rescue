{
  "schemaVersion": 1,
  "id": "wuxianpi.first-install.install",
  "title": "初始化 WuxianPi",
  "executionPolicy": {
    "beforePersistentTermux": "execute_termux_command",
    "afterPersistentTermux": "termux_exec_command",
    "longRunningCommands": "termux_exec_command",
    "serviceLifecycle": "service-manager"
  },
  "steps": [
    {
      "id": "inspect",
      "kind": "tool",
      "tool": "inspect_wuxianpi_setup",
      "description": "检查宿主类型、Termux、权限、安装载荷和服务真实状态。"
    },
    {
      "id": "prepare-host",
      "kind": "tool",
      "tool": "prepare_runtime_host",
      "description": "准备 Termux bootstrap 和宿主命令通道；已完成时跳过。"
    },
    {
      "id": "termux-home",
      "kind": "tool",
      "tool": "request_termux_home_access",
      "when": "runtimeHost.externalTermux && !permissions.termuxHomeWorkspace",
      "description": "显示用户点击后才跳转的 SAF 授权卡片，并确认工作区已绑定到 Termux Home。"
    },
    {
      "id": "run-command",
      "kind": "tool",
      "tool": "request_termux_run_command_permission",
      "when": "runtimeHost.externalTermux",
      "description": "获取外部 Termux RUN_COMMAND 权限后立即执行真实命令验证。只有验证命令成功才算本步骤完成；若 Termux 报 allow-external-apps 未启用，必须通过已授权的 SAF Termux Home 文件通道把 ~/.termux/termux.properties 中 allow-external-apps = true 启用，再重新执行本步骤，不能直接进入持久终端准备。"
    },
    {
      "id": "persistent-terminal",
      "kind": "tool",
      "tool": "prepare_persistent_termux",
      "description": "先测试软件源，再安装 tmux 的最小前置依赖并建立持久终端。"
    },
    {
      "id": "read-control-plane-start-script",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/control-plane/start-control-plane-termux-native.sh"
      },
      "description": "读取版本化的 OpenHouse 控制面启动脚本；Android 侧固定入口会调用这个 Termux 脚本。"
    },
    {
      "id": "read-control-plane-repair-script",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/control-plane/repair-control-plane-termux-native.sh"
      },
      "description": "读取控制面受控修复脚本。"
    },
    {
      "id": "read-control-plane-inspect-script",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/control-plane/inspect-control-plane-termux-native.sh"
      },
      "description": "读取控制面诊断脚本，供维修助手输出结构化检查结果。"
    },
    {
      "id": "read-control-plane-manifest",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/control-plane/control-plane-manifest.json"
      },
      "description": "读取控制面包校验清单；它必须最后写入 Termux，作为完整投放标记。"
    },
    {
      "id": "prepare-control-plane-directory",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "mkdir -p \"$HOME/.local/share/openhouseai/control-plane/current\"",
        "working_directory": "$HOME",
        "session_name": "openhouse-control-plane-stage",
        "yield_time_ms": 1000
      },
      "description": "准备由 OpenHouse 管理的控制面目录，不覆盖旧 bootstrap 或用户目录。"
    },
    {
      "id": "write-control-plane-start-script",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-control-plane-start-script",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/openhouseai/control-plane/current/start-control-plane-termux-native.sh",
        "content": "{{steps.read-control-plane-start-script.content}}"
      },
      "description": "投放控制面启动脚本。"
    },
    {
      "id": "write-control-plane-repair-script",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-control-plane-repair-script",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/openhouseai/control-plane/current/repair-control-plane-termux-native.sh",
        "content": "{{steps.read-control-plane-repair-script.content}}"
      },
      "description": "投放控制面修复脚本。"
    },
    {
      "id": "write-control-plane-inspect-script",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-control-plane-inspect-script",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/openhouseai/control-plane/current/inspect-control-plane-termux-native.sh",
        "content": "{{steps.read-control-plane-inspect-script.content}}"
      },
      "description": "投放控制面诊断脚本。"
    },
    {
      "id": "write-control-plane-manifest",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-control-plane-manifest",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/openhouseai/control-plane/current/control-plane-manifest.json",
        "content": "{{steps.read-control-plane-manifest.content}}"
      },
      "description": "最后写入控制面 manifest，使 Native Android 入口和维修助手都能识别完整包。"
    },
    {
      "id": "make-control-plane-scripts-executable",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "chmod 700 \"$HOME/.local/share/openhouseai/control-plane/current/\"*-control-plane-termux-native.sh",
        "working_directory": "$HOME",
        "session_name": "openhouse-control-plane-stage",
        "yield_time_ms": 1000
      },
      "description": "收紧控制面脚本权限；脚本只读取 canonical config，绝不输出 token。"
    },
    {
      "id": "stage-setup",
      "kind": "tool",
      "tool": "start_wuxianpi_setup",
      "description": "转移安装载荷，并按当前宿主返回前台安装所需的 command、session_name 和 yield_time_ms；Native 命令解包并调用原始资源，All-in-One 命令调用已暂存的 /bin/wuxianpi-setup；WuxianPi 只注册不默认启动。"
    },
    {
      "id": "run-setup-native",
      "kind": "tool-from-result",
      "tool": "termux_exec_command",
      "sourceStep": "stage-setup",
      "when": "runtimeHost.externalTermux",
      "description": "Native 宿主使用 stage-setup 返回的 command、session_name 和 yield_time_ms；该命令必须先解包并调用 install-resources/current/bootstrap/wuxianpi-setup 原始脚本，绝不能改为执行 $PREFIX/bin/wuxianpi-setup，避免重跑时安装器自复制源与目标相同而退出。"
    },
    {
      "id": "run-setup-embedded",
      "kind": "tool-from-result",
      "tool": "termux_exec_command",
      "sourceStep": "stage-setup",
      "when": "!runtimeHost.externalTermux",
      "description": "All-in-One 宿主使用 stage-setup 返回的 command、session_name 和 yield_time_ms；该命令调用宿主已暂存的 /bin/wuxianpi-setup，不得拼接 Native 专用的 install-resources 路径。"
    },
    {
      "id": "verify",
      "kind": "poll-tool",
      "tool": "get_wuxianpi_setup_status",
      "retryPolicy": {
        "maxAttempts": 10,
        "delayMs": 3000,
        "retryWhen": [
          "runsvdir 尚未就绪",
          "sv up service-manager 返回 unable to change to service directory",
          "service-manager 20087 健康检查暂不可达"
        ]
      },
      "description": "轮询安装状态，并检查 service-daemon、runsvdir、sv status service-manager、20087、WuxianPi 服务声明、Ubuntu 和终端能力。termux-services 首次启动可能存在 runsvdir 时序窗口；遇到 unable to change to service directory 或暂时不可达时，按 retryPolicy 等待后重试 readiness，不要立即判定安装失败。WuxianPi stopped 是正常按需状态。"
    },
    {
      "id": "start-openhouse-control-plane",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "\"$PREFIX/bin/bash\" \"$HOME/.local/share/openhouseai/control-plane/current/inspect-control-plane-termux-native.sh\" start",
        "working_directory": "$HOME",
        "session_name": "openhouse-control-plane-start",
        "yield_time_ms": 1000
      },
      "description": "通过与 Android 固定入口相同的完整 Termux 控制脚本启动 service-manager；它会先确保 service-daemon/runsvdir，再验证带认证的 20087 API。"
    },
    {
      "id": "verify-openhouse-control-plane",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "\"$PREFIX/bin/bash\" \"$HOME/.local/share/openhouseai/control-plane/current/inspect-control-plane-termux-native.sh\" inspect",
        "working_directory": "$HOME",
        "session_name": "openhouse-control-plane-inspect",
        "yield_time_ms": 1000
      },
      "description": "输出 control_plane_* 结构化状态。若 bundle、runsvdir、服务定义或认证 health 任一项失败，维修助手应依据 recommendation 使用 repair，而不是重复安装 WuxianPi。"
    },
    {
      "id": "read-openhouse-registration-script",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/register-openhouse-component.sh"
      },
      "description": "读取版本化的 OpenHouse 桌面组件注册脚本，使用与 yuanshengwuxianpi 服务一致的组件 ID，避免由 Agent 临时拼接注册清单。"
    },
    {
      "id": "prepare-openhouse-registration-directory",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "mkdir -p \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.first-install\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-openhouse-registration-prepare",
        "yield_time_ms": 1000
      },
      "description": "准备插件脚本的 Termux 持久目录。"
    },
    {
      "id": "write-openhouse-registration-script",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-openhouse-registration-script",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/wuxianpi/plugins/wuxianpi.first-install/register-openhouse-component.sh",
        "content": "{{steps.read-openhouse-registration-script.content}}"
      },
      "description": "将当前插件版本的注册脚本写入 Termux Home；脚本只管理 yuanshengwuxianpi 组件，不删除用户组件或 WuxianPi 服务。"
    },
    {
      "id": "register-openhouse-component",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "chmod 700 \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.first-install/register-openhouse-component.sh\" && \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.first-install/register-openhouse-component.sh\" register",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-openhouse-component-register",
        "yield_time_ms": 1000
      },
      "description": "通过 canonical service-manager 注册或修复 yuanshengwuxianpi 桌面组件；必要时迁移已确认属于 WuxianPi 的旧 pi-agent 清单，重复执行安全。"
    },
    {
      "id": "verify-openhouse-component",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "\"$HOME/.local/share/wuxianpi/plugins/wuxianpi.first-install/register-openhouse-component.sh\" verify",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-openhouse-component-verify",
        "yield_time_ms": 1000
      },
      "description": "验证 components.d/yuanshengwuxianpi.json 和 service-manager registry API；新版宿主返回后可刷新桌面组件，旧 APK 才需要完全退出并重新打开。"
    }
  ]
}
