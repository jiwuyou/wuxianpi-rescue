{
  "schemaVersion": 1,
  "id": "wuxianpi.resource-update.update",
  "title": "更新 APK 资源",
  "executionPolicy": { "beforePersistentTermux": "execute_termux_command", "afterPersistentTermux": "termux_exec_command" },
  "steps": [
    { "id": "prepare", "kind": "tool", "tool": "prepare_persistent_termux", "description": "准备资源更新所需的持久 Termux 命令通道。" },
    { "id": "read-script", "kind": "tool", "tool": "read_rescue_plugin_document", "arguments": { "pluginId": "wuxianpi.resource-update", "path": "scripts/update-resources.sh" }, "description": "读取当前市场版本的资源更新脚本。" },
    { "id": "write-script", "kind": "tool-from-result", "tool": "write_file", "sourceStep": "read-script", "arguments": { "environment": "repo:termux-home", "path": ".local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh", "content": "{{steps.read-script.content}}" }, "description": "写入版本化资源更新脚本。" },
    { "id": "plan", "kind": "tool", "tool": "termux_exec_command", "arguments": { "command": "chmod 700 \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" && \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" plan", "working_directory": "$HOME", "session_name": "wuxianpi-resource-update", "yield_time_ms": 1000 }, "description": "比较完整核心资源集合、本机安装凭据、缓存和 APK 离线资源，并报告真正需要下载的字节数。" },
    { "id": "apply", "kind": "tool", "tool": "termux_exec_command", "arguments": { "command": "\"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" apply", "working_directory": "$HOME", "session_name": "wuxianpi-resource-update", "yield_time_ms": 1000 }, "description": "下载差异资源，全部校验和暂存后执行版本化切换；任何资源失败时恢复旧 current。" },
    { "id": "verify", "kind": "tool", "tool": "termux_exec_command", "arguments": { "command": "\"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" verify", "working_directory": "$HOME", "session_name": "wuxianpi-resource-update-verify", "yield_time_ms": 1000 }, "description": "重新计算已安装文件清单并检查五个资源处理器、service-manager 和 registry。" }
  ]
}
