{
  "schemaVersion": 1,
  "id": "wuxianpi.background-run-guide",
  "version": "1.0.1",
  "name": "后台运行指导",
  "description": "引导用户查询并完成 Android 应用后台运行、电池和自启动设置，不申请系统权限或自动修改系统设置。",
  "category": "setup",
  "minHostVersion": 12,
  "requiredCapabilities": [],
  "tags": ["后台运行", "电池优化", "自启动", "Android"],
