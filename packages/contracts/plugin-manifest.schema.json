{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuxianpirescue.webefficacy.com/schemas/plugin-manifest-v1.json",
  "title": "WuxianPi Rescue Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "name", "description", "category",
    "minHostVersion", "requiredCapabilities", "tags", "documents"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "minHostVersion": { "type": "integer", "minimum": 1 },
    "requiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "entryWorkflow": { "$ref": "#/$defs/safePath" },
    "assistantContexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "scope"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "scope": { "enum": ["session", "turn"] },
          "provider": { "enum": ["static", "javascript"], "default": "static" },
          "function": { "type": "string", "pattern": "^[A-Za-z_$][0-9A-Za-z_$]*$" }
        },
        "allOf": [
          {
            "if": {
              "required": ["provider"],
              "properties": { "provider": { "const": "javascript" } }
            },
            "then": { "required": ["function"] }
          },
          {
            "if": {
              "required": ["provider"],
              "properties": { "provider": { "const": "static" } }
            },
            "then": { "not": { "required": ["function"] } }
          }
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "title"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"
    }
  }
}
