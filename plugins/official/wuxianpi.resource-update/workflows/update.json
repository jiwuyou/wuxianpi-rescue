{
  "schemaVersion": 1,
  "id": "wuxianpi.resource-update.update",
  "title": "更新 APK 资源",
  "executionPolicy": { "beforePersistentTermux": "execute_termux_command", "afterPersistentTermux": "termux_exec_command" },
  "steps": [
    { "id": "prepare", "kind": "tool", "tool": "prepare_persistent_termux", "description": "准备资源更新所需的持久 Termux 命令通道。" },
    { "id": "read-script", "kind": "tool", "tool": "read_rescue_plugin_document", "arguments": { "pluginId": "wuxianpi.resource-update", "path": "scripts/update-resources.sh" }, "description": "读取当前市场版本的资源更新脚本。" },
    { "id": "write-script", "kind": "tool-from-result", "tool": "write_file", "sourceStep": "read-script", "arguments": { "environment": "repo:termux-home", "path": ".local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh", "content": "{{steps.read-script.content}}" }, "description": "写入版本化资源更新脚本。" },
    { "id": "stage-apk-bundle", "kind": "tool", "tool": "stage_apk_resource_bundle", "description": "按长度复用或投递 APK canonical TAR，以便差异计划优先复用 APK 中同版本资源。" },
    { "id": "plan", "kind": "tool", "tool": "termux_exec_command", "arguments": { "command": "chmod 700 \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" && \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" plan", "working_directory": "$HOME", "session_name": "wuxianpi-resource-update", "yield_time_ms": 1000 }, "description": "比较本机、APK 和市场集合，按 sequence 选择目标并展示五个资源的真实差异来源。" },
    { "id": "apply", "kind": "tool", "tool": "termux_exec_command", "arguments": { "command": "\"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" apply", "working_directory": "$HOME", "session_name": "wuxianpi-resource-update", "yield_time_ms": 1000 }, "description": "仅获取版本不同的资源，调用固定内容管理器完成静态事务，再单独执行运行激活。" },
    { "id": "verify", "kind": "tool", "tool": "termux_exec_command", "arguments": { "command": "\"$HOME/.local/share/wuxianpi/plugins/wuxianpi.resource-update/update-resources.sh\" verify", "working_directory": "$HOME", "session_name": "wuxianpi-resource-update-verify", "yield_time_ms": 1000 }, "description": "分别验证五个静态资源 current/receipt 和运行激活状态。" }
  ]
}
